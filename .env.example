# ESP Application Backend settings. Copy to .env for local development only; never commit real values.
# There are no defaults for identity keys and no bypass settings. Production refuses missing keys,
# placeholder keys, an http origin, a missing session expiry and every qualification-only variable.

# production | qualification | development. Development uses the separate esp_dev_session cookie
# and requires a loopback origin.
ESP_ENVIRONMENT=development
ESP_PUBLIC_ORIGIN=http://127.0.0.1:8080
# Local disposable database from infra/local/compose.yaml, connected as the restricted application role.
ESP_DATABASE_URL=postgresql://esp_app:esp_app@127.0.0.1:54329/esp

# Session key ring: comma-separated kid:base64url-key entries of at least 32 random bytes each.
# The first key signs; the others verify only while a rotation completes. Generate one locally with:
#   python -c "import secrets; print('k1:' + secrets.token_urlsafe(32))"
ESP_SESSION_KEYS=
# Cookie lifetime in seconds. Required in production, where it is a release input.
ESP_SESSION_MAX_AGE_SECONDS=

# Brain release selected for new conversations, and the exact runtime profile of each provider pool.
ESP_BRAIN_RELEASE_ID=
ESP_RUNTIME_PROFILES_PATH=

# Isolated qualification deployment only (ESP_ENVIRONMENT=qualification). Every other environment
# refuses these. The recorded candidate policy must name this cluster UID and deployment reference.
ESP_CANDIDATE_POLICY_PATH=
ESP_QUALIFICATION_CLUSTER_UID=
ESP_QUALIFICATION_DEPLOYMENT_REF=
