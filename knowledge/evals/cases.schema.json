{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Owner evaluation cases",
  "type": "object",
  "additionalProperties": false,
  "required": ["notice", "cases"],
  "properties": {
    "notice": {"type": "string", "minLength": 1},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "category",
          "question",
          "required_concepts",
          "required_sources",
          "retrieval_expected",
          "prohibited_claims",
          "rubric_ref",
          "unavailable_value",
          "requires_source",
          "approved_domain_content"
        ],
        "properties": {
          "case_id": {"type": "string", "minLength": 1},
          "category": {
            "enum": [
              "conceptual",
              "counterfactual",
              "misconception",
              "edge",
              "version_specific",
              "exact_factual",
              "retrieval"
            ]
          },
          "question": {"type": "string", "minLength": 1},
          "required_concepts": {"type": "array", "items": {"type": "string"}},
          "required_sources": {"type": "array", "items": {"type": "string"}},
          "retrieval_expected": {"type": "boolean"},
          "prohibited_claims": {"type": "array", "items": {"type": "string"}},
          "rubric_ref": {"type": "string", "minLength": 1},
          "unavailable_value": {"type": "boolean"},
          "requires_source": {"type": "boolean"},
          "approved_domain_content": {"type": "boolean"}
        }
      }
    }
  }
}
