{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openedge.example/qualification/acceptance-budgets.schema.json",
  "title": "Preapproved DA-01 acceptance budgets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "owner",
    "reviewed_at",
    "workload",
    "saved_session_target",
    "resident_session_target",
    "active_turn_target",
    "provider_rpm",
    "provider_tpm",
    "memory_baseline_bytes",
    "memory_increment_bytes",
    "memory_peak_bytes",
    "memory_reclamation_bytes",
    "p95_admission_ms",
    "p95_warm_ms",
    "p95_restore_ms",
    "p95_ttft_ms",
    "rejection_objective",
    "recovery_objective",
    "run_spend_ceiling",
    "test_spend_ceiling",
    "cost_per_completed_answer",
    "prices_as_of",
    "recovery_headroom",
    "transport_digest",
    "provider",
    "approved"
  ],
  "properties": {
    "owner": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "minLength": 1},
    "workload": {"type": "string", "minLength": 1},
    "saved_session_target": {"type": "integer", "minimum": 1},
    "resident_session_target": {"type": "integer", "minimum": 1},
    "active_turn_target": {"type": "integer", "minimum": 1},
    "provider_rpm": {"type": "integer", "minimum": 1},
    "provider_tpm": {"type": "integer", "minimum": 1},
    "memory_baseline_bytes": {"type": "integer", "minimum": 0},
    "memory_increment_bytes": {"type": "integer", "minimum": 0},
    "memory_peak_bytes": {"type": "integer", "minimum": 0},
    "memory_reclamation_bytes": {"type": "integer", "minimum": 0},
    "p95_admission_ms": {"type": "integer", "minimum": 0},
    "p95_warm_ms": {"type": "integer", "minimum": 0},
    "p95_restore_ms": {"type": "integer", "minimum": 0},
    "p95_ttft_ms": {"type": "integer", "minimum": 0},
    "rejection_objective": {"type": "string", "minLength": 1},
    "recovery_objective": {"type": "string", "minLength": 1},
    "run_spend_ceiling": {"type": "string", "minLength": 1},
    "test_spend_ceiling": {"type": "string", "minLength": 1},
    "cost_per_completed_answer": {"type": "string", "minLength": 1},
    "prices_as_of": {"type": "string", "minLength": 1},
    "recovery_headroom": {"type": "integer", "minimum": 0},
    "transport_digest": {"type": "string", "minLength": 1},
    "provider": {"enum": ["openai", "xai"]},
    "approved": {"type": "boolean"}
  }
}
