  "g0_observations": [
    {
      "how": "initialize-only run, same isolation",
      "observation": "Unknown configuration keys and sections are silently ignored: a draft configuration with an unknown feature key and an unknown section still completed the initialize handshake with its other settings applied."
    },
    {
      "how": "initialize-only run, same isolation; the probe configuration contained a duplicate table",
      "observation": "A TOML syntax error makes the build refuse to start (`Failed to load config`)."
    },
    {
      "how": "grok inspect --json, same isolation",
      "observation": "grok inspect --json loaded every permission rule of a probe configuration, including one naming a tool that does not exist (27 loaded, 0 skipped): rule tool names are not validated."
    },
    {
      "how": "grok inspect --json, same isolation",
      "observation": "grok inspect --json listed the esp_knowledge MCP server (transport http) from the user configuration layer."
    },
    {
      "how": "files written into the isolated GROK_HOME",
      "observation": "The build unpacks its user guide into $GROK_HOME/docs/user-guide on launch. It documents session/load replay, session/set_config_option, the {{session_id}} MCP header template, sandbox profiles and permission rules. Documentation is a declaration, not runtime evidence."
    },
    {
      "how": "initialize-only run without configuration",
      "observation": "The initialize result advertises X search tool overrides (x_keyword_search, x_semantic_search true) under agentCapabilities._meta; whether features.backend_tools = false removes them was not observed."
    }
  ],
